# Copia este archivo como .env (nunca subas el .env a git).

NODE_ENV=production

# Base de datos (Supabase → Connect → Session pooler). Opción B: variables DB_* sueltas.
DATABASE_URL=postgresql://usuario:password@host:5432/postgres
# DB_SSL=false   # solo para una BD local sin SSL

# Secreto para firmar sesiones: mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=4h

# Dominios exactos que pueden usar la API (separados por coma, sin "/" final).
CORS_ORIGINS=https://tu-frontend.vercel.app
# URL pública del frontend, usada en los enlaces de recuperación de contraseña.
FRONTEND_URL=https://tu-frontend.vercel.app

# Correo para recuperación de contraseña (Gmail → contraseña de aplicación).
MAIL_USER=
MAIL_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Demo pública de solo lectura (para portafolio). Crea el usuario con: npm run db:seed
DEMO_ENABLED=true
# DEMO_EMAIL=demo@inveschool.app
